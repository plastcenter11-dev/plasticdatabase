# Copy to backend/.env on the server and fill in. Never commit the real file.

DB_HOST=localhost
DB_USER=plasticdb_app
DB_PASS=CHANGE_ME_LONG_RANDOM_PASSWORD
DB_NAME=plasticdatabase

PORT=3001
NODE_ENV=production

# At least 32 random characters. Make one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs everybody out.
JWT_SECRET=

# The program sits behind Caddy (one proxy in front of it), so trust its X-Forwarded-For header.
TRUST_PROXY=1

# Other websites allowed to call the API from a browser. Leave empty: the screens come from this server.
CORS_ORIGINS=

# Hours a sign-in lasts.
TOKEN_LIFETIME=12h

# Only used the very first time, when no admin exists yet. Without it a random password is printed once.
# ADMIN_INITIAL_PASSWORD=

# Second copy of every daily backup (a synced cloud folder, a USB drive, a network share).
# It can also be chosen from Settings > Backup.
# BACKUP_COPY_DIR=
